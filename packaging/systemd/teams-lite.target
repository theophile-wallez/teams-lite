[Unit]
# One handle for the whole feature:
#   systemctl --user enable --now teams-lite.target
#   systemctl --user restart teams-lite.target
#   systemctl --user status teams-lite.target
Description=teams-lite (backend + production web UI)
Documentation=https://github.com/theophile-wallez/teams-lite
Documentation=file://@REPO@/README.md

# Wants= pulls the members in when the target starts. What makes a target RESTART
# reach them is `PartOf=teams-lite.target` on each member — a target on its own has
# no members, so without that line a restart here would do nothing at all.
Wants=teams-lite-backend.service
Wants=teams-lite-web.service
After=teams-lite-backend.service
After=teams-lite-web.service

# TWO MEMBERS, AND NOTHING THAT WATCHES THE INTUNE CONTAINER. This target used to pull in a
# .path unit restarting the backend whenever the container rewrote rootless.json, a timer
# that checked the container's keyring every fifteen minutes, and an ordering on the repair
# unit that kept its rate-limit counters in memory. All three existed because the broker's
# D-Bus address was frozen into the backend's environment at exec and the repair was an
# installed unit running the `intune-container` binary. The backend now resolves that bus on
# every connection and checks the keyring and asks for the repair itself (src/intune.rs,
# `spawn_broker_health` in src/bin/server.rs), so a container restart is followed with no
# restart of ours and the rate limit lives in the store every backend shares.
# bin/teams-lite-service.sh RETIRES those units on a machine that still has them.

[Install]
WantedBy=default.target
