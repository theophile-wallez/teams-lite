[Unit]
# Installed by bin/teams-lite-service.sh, which substitutes every @token@ below.
# Do not hand-edit the installed copy: `teams-lite-service.sh update` rewrites it.
# Put local overrides in @CONFIG_DIR@/backend.env, which is read below and is not
# touched by an update.
Description=teams-lite backend (Teams/Outlook bridge on ws://127.0.0.1:@BACKEND_PORT@)
Documentation=https://github.com/theophile-wallez/teams-lite
Documentation=file://@REPO@/README.md

# NO relation to intune-container.service, in either direction. The backend follows the
# Intune container LIVE — it reads where the broker's D-Bus is from the container's own
# runtime state on every connection (src/intune.rs) — so a container restart needs no
# restart of ours, and a container that is not up yet costs a retried token call rather
# than a refused start. And stopping the container must not stop this unit: the store keeps
# serving the history while sign-in is down (AGENTS.md § A broken sign-in costs the LIVE
# feed). The PartOf= that used to sit here propagated a container restart, which was the
# only way a frozen bus address could be re-read; a backend that asks per connection has
# nothing to re-read. It was a weak signal even then: that unit exists only where the user
# ran `intune-container autostart enable`, and it is a Type=oneshot that stays "active
# (exited)" while the container restarts itself underneath it, so its state never said
# where the bus was.
PartOf=teams-lite.target

# Retry forever, and never latch to "failed". This unit is the user's always-on client:
# a crash, an in-app restart (which is an exit, below) and a port held for a moment by a
# backend that is still going away are all things it must come back from on its own. Note
# the section: StartLimit* belongs in [Unit], and a copy of it under [Service] is silently
# ignored.
StartLimitIntervalSec=0

[Service]
Type=exec
WorkingDirectory=@SERVICE_DIR@

# The binary itself, with no wrapper in front of it, so it is the unit's MainPID and
# Type=exec, KillSignal= and Restart= act on the real process. It used to be a shell
# wrapper, because the broker's bus path embeds the container's leader PID and systemd's
# Environment= is static: the wrapper resolved it, waited for it, checked the keyring and
# froze the answer into DBUS_SESSION_BUS_ADDRESS at exec. The backend now answers all three
# questions in process (src/intune.rs) and no D-Bus address is set here at all — an
# inherited one would only be a stale answer the backend has to ignore.
ExecStart=@SERVICE_DIR@/server

# MANDATORY. Without it the backend exits ~10 s after the last frontend disconnects
# (30 s if none ever connected) — which for a service means seconds after every
# start, in a permanent restart loop.
Environment=TEAMS_NO_IDLE_EXIT=1
# Stated explicitly so a stray TEAMS_LITE_READ_ONLY in the environment cannot move
# the listener to the read-only port and leave the web unit talking to nothing.
Environment=TEAMS_LITE_PORT=@BACKEND_PORT@
# This unit starts the backend again when it exits (Restart=always, below), and that is
# what lets the app offer Settings › This app › Restart the backend: the backend restarts
# by EXITING here, and there is nothing for it to ask. It is declared rather than detected
# because a process cannot read its own unit's Restart=, and an INVOCATION_ID inherited
# from a parent unit would make a hand-started backend look supervised — see
# src/restart.rs, whose test pins this line against the Restart= below. Move one, move
# the other.
Environment=TEAMS_LITE_RESTART_ON_EXIT=1
# The local agent spawns its CLI by name (`claude`, `opencode`), and the systemd user
# manager's PATH holds neither ~/.local/bin nor ~/.bun/bin — the same gap the web unit
# works around with an absolute @BUN@. Without this the trigger is dropped with one
# journal line and the thread stays silent, which reads as a broken feature.
Environment=PATH=@AGENT_PATH@

# Local overrides. The "-" makes a missing file harmless. Calling is NOT among them and
# has no environment value at all: every backend but a read-only one registers as a device
# the user's calls ring on, like every other client they are signed in on, and two on one
# machine are two devices (each holds an endpoint id keyed by its port).
# Deliberately NOT set here: TEAMS_LITE_CALL_DEBUG and TEAMS_LITE_CALL_CAPTURE
# (they write call identities, SDP and session keys, and this host keeps the journal for
# weeks).
EnvironmentFile=-@CONFIG_DIR@/backend.env

Restart=always
RestartSec=5
# Walk 5 s -> 300 s over six steps, then stay there: a backend that cannot start (its
# port held by something else, a store it cannot open) then costs a dozen retries an hour
# instead of several hundred. A broker outage is not one of those — sign-in runs after the
# store is served and a broken one is never fatal. Both directives are required — each is
# ignored without the other.
RestartSteps=6
RestartMaxDelaySec=300

# The backend installs no signal handler, so SIGTERM stops it at once. Nothing needs
# a drain: SQLite runs in WAL mode with per-request commits, so an abrupt stop can
# lose nothing that was acknowledged.
KillSignal=SIGTERM
TimeoutStopSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=teams-lite-backend

[Install]
WantedBy=teams-lite.target
