[Unit]
# Installed by bin/teams-lite-service.sh, which substitutes every @token@ below.
Description=Check the Intune broker keyring, and repair it if it re-locked
Documentation=file://@REPO@/bin/teams-lite-broker-check.sh
# Started by the timer, never by the target: PartOf= keeps `systemctl --user restart
# teams-lite.target` from reaching in here.
PartOf=teams-lite.target

[Service]
Type=oneshot

# THE CASE THIS COVERS. With nobody in Mail, nobody in the Calendar, and a live
# real-time socket, the backend makes NO broker calls at all: the token cache is lazy
# (50 minutes), both pollers are gated on a client actually opening those surfaces, and
# the real-time socket only needs credentials when it reconnects. So a keyring that
# locks at 03:00 can go unnoticed until someone opens the app and finds it empty —
# which is exactly what happened. This is the only trigger that works while no client
# is connected.
#
# It never runs `intune-container` itself: it asks teams-lite-broker-repair.service,
# so the rate limit stays in one place and counts every trigger together.
ExecStart=@SERVICE_DIR@/teams-lite-broker-check.sh --repair

# The script exits 1 when the keyring was locked, which is information rather than a
# failure of this unit. Only 2 (could not tell) and a crash are worth marking failed.
SuccessExitStatus=1

StandardOutput=journal
StandardError=journal
SyslogIdentifier=teams-lite-broker-health
