{
  "name": "teams-lite-web",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "bun run sync:emoji",
    "dev": "bun run sync:emoji && VITE_TEAMS_WS_URL=${VITE_TEAMS_WS_URL:-ws://127.0.0.1:19421} vite dev",
    "dev:mock": "bun run sync:emoji && { PORT=19455 MOCK_TEST_HOOKS=1 bun run mock/server.ts & MOCK_PID=$!; trap 'kill $MOCK_PID' EXIT; VITE_TEAMS_WS_URL=ws://127.0.0.1:19455 vite dev --port 19445; }",
    "dev:server": "../bin/teams-dev-server.sh",
    "preview": "bun run sync:emoji && bun run scripts/preview.ts",
    "sandbox": "bun run scripts/sandbox-live.ts",
    "join-live": "bun run scripts/join-live.ts",
    "call-live": "bun run scripts/call-live.ts",
    "build": "bun run sync:emoji && vite build",
    "sync:emoji": "bun run scripts/sync-emoji-assets.ts",
    "generate:emoji": "bun run scripts/generate-teams-emoji.ts",
    "generate:emoji-shortcodes": "bun run scripts/generate-emoji-shortcodes.ts",
    "start": "bun run server.ts",
    "mock": "bun run mock/server.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.2.3",
    "@hugeicons/react": "^1.1.9",
    "@pierre/diffs": "1.3.4",
    "@pierre/trees": "1.0.0-beta.6",
    "@radix-ui/react-dialog": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.21",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.15",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.13",
    "@radix-ui/react-visually-hidden": "^1.2.8",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-start": "^1.168.32",
    "@tanstack/react-store": "^0.11.0",
    "@tanstack/react-virtual": "^3.14.7",
    "@tanstack/store": "^0.11.0",
    "@tiptap/extension-link": "^3.28.0",
    "@tiptap/extension-placeholder": "^3.28.0",
    "@tiptap/extension-underline": "^3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "anser": "^2.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cuelume": "^0.1.2",
    "emoji-mart": "^5.6.0",
    "motion": "^12.42.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.16.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "thinking-orbs": "^0.2.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5",
    "emoji-datasource-apple": "^16.0.0",
    "happy-dom": "^20.11.0",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.61.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  }
}
