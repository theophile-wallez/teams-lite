# dependencies
# No trailing slash, so a `node_modules` SYMLINK — how a worktree borrows the main
# checkout's install — is ignored too, and can never be staged by mistake.
node_modules

# Apple emoji images, copied out of the emoji-datasource-apple dependency by
# scripts/sync-emoji-assets.ts (~3800 files) instead of committed.
public/emoji/

# build output
dist/
.output/
.nitro/
.tanstack/
.vinxi/

# playwright
test-results/
playwright-report/
blob-report/
.playwright/

# logs / env
*.log
.env
.env.*
!.env.example
