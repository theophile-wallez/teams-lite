/target

# tooling artifacts (skill-registry cache), not part of the app
.atl/

# git worktree copies created for parallel sessions
.worktrees/

# where the browser MCP server drops snapshots, console logs and evaluation results.
# Reading a live page with those tools is allowed (see AGENTS.md § Automation safety);
# what it writes down is a diagnostic of one session, never part of the app — and a
# console log of the real Teams client can hold session detail, so it must not be
# committable by accident.
.playwright-mcp/

# dependencies. No trailing slash, so a `node_modules` SYMLINK — how a worktree
# borrows the main checkout's install — is ignored too, and can never be staged by
# mistake (web/.gitignore says the same for the web app's own install).
node_modules

# Playwright's own failure artifacts. `web/.gitignore` already names this, and that is
# not enough: the E2E config resolves `outputDir` against the CWD, so a run started
# from the REPO ROOT rather than from `web/` leaves the directory HERE — untracked, and
# one `git add -A` away from committing somebody's screenshots and traces.
test-results/
